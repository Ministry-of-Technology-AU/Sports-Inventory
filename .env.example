# MySQL / Database configuration (LOCAL)
# Make sure your local MySQL has the SportsInventory database created
# Run the TABLE-COMMANDS.md SQL statements to set up the schema
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Application Configuration
BASE_URL=http://localhost:3000
SECRET_KEY="ABCDEF"
PORT=3000

# Google OAuth2 for Admin Authentication
CLIENT_ID=
CLIENT_SECRET=
CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Google App Password for Nodemailer
EMAIL_USER=
EMAIL_PASS=

# Webhook API
WEBHOOK_API_KEY=
# Overdue threshold configuration:
# Option 1: Use hours (supports decimals, e.g., 0.5 = 30 minutes)
OVERDUE_THRESHOLD_HOURS=6
# Option 2: Use minutes directly (takes priority if set, e.g., 5 = 5 minutes for testing)
# OVERDUE_THRESHOLD_MINUTES=

# Comma-separated list of authorized admin emails
ALLOWED_EMAILS=
ADMIN_EMAILS=
