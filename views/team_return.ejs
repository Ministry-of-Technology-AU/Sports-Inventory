<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sports Team Return</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/style/landing.css" />
    <link rel="stylesheet" href="/style/return-page.css" />
    <link rel="stylesheet" href="/style/global.css" />

    <style>
      body {
        background-color: var(--off-white);
      }

      .button-group {
        display: flex;
        gap: 15px;
        justify-content: center;
        align-items: center;
      }

      #returnAllBtn,
      #returnSelectedBtn {
        background: var(--primary-color);
        color: var(--text-color-secondary);
        border: none;
        padding: 16px 36px;
        font-size: 18px;
        font-weight: 600;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      #returnAllBtn:hover,
      #returnSelectedBtn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(13, 56, 98, 0.3);
      }

      .up {
        justify-content: space-between;
      }
    </style>
  </head>

  <body>
    <%- include("nav",{ activePage: "team-return", config: "admin", userName:
    user }) %>

    <div class="box">
      <div class="up">
        <h1 class="details">
          <p><%= student.name %></p>
          <p><%= student.AshokaId %></p>
        </h1>

        <h1>Equipment Reserved</h1>

        <h1
          style="
            margin-left: 20px;
            font-size: 24px;
            background-color: var(--tertiary-color);
            padding: 4px;
            border-radius: 4px;
            color: white;
          "
        >
          Sports Team Return
        </h1>
      </div>

      <% if (equipment.length === 0) { %>
      <p class="noPendingEquipment">No pending equipment</p>
      <% } else { %>
      <table border="1" cellpadding="5">
        <thead>
          <tr>
            <th>Equipment</th>
            <th>Quantity Reserved</th>
            <th>Date of Reserving</th>
            <th>Return</th>
          </tr>
        </thead>
        <tbody>
          <% equipment.forEach(function(item) { %>
          <tr>
            <td><%= item.equipment %></td>
            <td><%= item.outNum %></td>
            <td><%= item.outTime %></td>
            <td>
              <label class="checkbox">
                <input
                  class="equipment-checkbox"
                  type="checkbox"
                  value="<%= item.equipment %>"
                  data-quantity="<%= item.outNum %>"
                />
                <span class="checkmark"></span>
              </label>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %> <% if (equipment.length !== 0) { %>
      <div class="bottom">
        <div class="button-group">
          <button id="returnSelectedBtn">Return Selected</button>
        </div>
      </div>
      <% } %>
    </div>
    <form id="teamReturnForm" method="POST" action="/return_team_equipment">
      <input type="hidden" name="equipments" id="equipmentsInput" />
    </form>

    <script>
      let returnInProgress = false;

      function disableReturnButtons() {
        const selectedBtn = document.getElementById("returnSelectedBtn");
        if (selectedBtn) selectedBtn.disabled = true;
      }

      function returnTeamEquipment(equipments) {
        if (returnInProgress) return;
        returnInProgress = true;
        disableReturnButtons();

        document.getElementById("equipmentsInput").value =
          JSON.stringify(equipments);

        document.getElementById("teamReturnForm").submit();
      }

      // Return Selected
      document
        .getElementById("returnSelectedBtn")
        ?.addEventListener("click", () => {
          const selected = Array.from(
            document.querySelectorAll(".equipment-checkbox:checked")
          ).map((cb) => ({
            equipment: cb.value,
            outNum: Number(cb.dataset.quantity),
          }));

          if (selected.length === 0) {
            alert("Please select at least one item to return.");
            return;
          }

          returnTeamEquipment(selected);
        });
    </script>
  </body>
</html>
