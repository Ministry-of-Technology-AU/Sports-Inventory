<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Landing Page</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style/landing.css" />
    <link rel="stylesheet" href="/style/return-page.css" />
    <link rel="stylesheet" href="/style/global.css" />
    <style>
      body {
        background-color: var(--off-white);
      }

      .button-group {
        display: flex;
        gap: 15px;
        justify-content: center;
        align-items: center;
      }

      #returnAllBtn {
        background: var(--primary-color);
        color: var(--text-color-secondary);
        border: none;
        padding: 16px 36px;
        font-size: 18px;
        font-weight: 600;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      #returnAllBtn:hover {
        background: var(--primary-color);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(13, 56, 98, 0.3);
      }
    </style>
  </head>

  <body>
    <%- include("nav",{ activePage: "landing" , config: "admin" , userName: user
    }) %>
    <div class="box">
      <div class="up">
        <h1 class="details">
          <p><%= student.name %></p>
          <p><%= student.AshokaId %></p>
        </h1>
        <h1>Pending Equipment Borrowed</h1>
        <h1 class="fake">H</h1>
      </div>

      <% if (equipment.length===0) { %>
      <p class="noPendingEquipment">No pending equipment</p>
      <% } else { %>
      <table border="1" cellpadding="5">
        <thead>
          <tr>
            <th>Equipment</th>
            <th>Checkout Time</th>
            <th>Damaged</th>
            <th>
              <label class="checkbox">
                <input id="selectAllReturns" type="checkbox" />
                <span class="checkmark"></span>
              </label>
            </th>
          </tr>
        </thead>
        <tbody>
          <% equipment.forEach(function(item) { %>
          <tr>
            <td><%= item.equipment %></td>
            <td><%= item.outTime %></td>
            <td>
              <label class="checkbox">
                <input
                  class="damaged-checkbox"
                  type="checkbox"
                  data-logid="<%= item.logID %>"
                />
                <span class="checkmark"></span>
              </label>
            </td>
            <td>
              <label class="checkbox">
                <input
                  class="equipment-checkbox"
                  type="checkbox"
                  data-logid="<%= item.logID %>"
                  data-equipment="<%= item.equipment %>"
                  data-base-equipment="<%= item.baseEquipment %>"
                />
                <span class="checkmark"></span>
              </label>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>

      <br />
      <% } %>

      <div class="bottom">
        <% if (equipment.length !=0) { %>
        <div class="button-group">
          <button id="returnSelectedBtn">Return Selected</button>
        </div>
        <% }%>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Select All functionality: attach handlers after DOM ready
        const selectAll = document.getElementById("selectAllReturns");

        const setAllEquipmentChecked = (checked) => {
          const allReturnCheckboxes = document.querySelectorAll(
            ".equipment-checkbox"
          );

          allReturnCheckboxes.forEach((cb) => {
            cb.checked = checked;
            // Ensure any other listeners react to the change
            cb.dispatchEvent(new Event("change", { bubbles: true }));
          });
        };

        if (selectAll) {
          selectAll.addEventListener("change", function () {
            setAllEquipmentChecked(this.checked);
          });

          // Fallback: some CSS/label layouts can prevent the native toggle.
          // Add a click handler on the wrapping label to force toggle.
          const wrapper = selectAll.closest(".checkbox");
          if (wrapper) {
            wrapper.addEventListener("click", (e) => {
              // Prevent double toggle from native label click
              e.preventDefault();
              selectAll.checked = !selectAll.checked;
              setAllEquipmentChecked(selectAll.checked);
            });
          }
        }

        // Keep select-all checkbox in sync with individual selections
        const equipmentCheckboxes = Array.from(
          document.querySelectorAll(".equipment-checkbox")
        );

        const updateSelectAllState = () => {
          const all = document.querySelectorAll(".equipment-checkbox");
          const checked = document.querySelectorAll(
            ".equipment-checkbox:checked"
          );

          const select = document.getElementById("selectAllReturns");
          if (!select) return;

          if (checked.length === 0) {
            select.checked = false;
            select.indeterminate = false;
          } else if (checked.length === all.length) {
            select.checked = true;
            select.indeterminate = false;
          } else {
            select.checked = false;
            select.indeterminate = true;
          }
        };

        equipmentCheckboxes.forEach((cb) => {
          cb.addEventListener("change", updateSelectAllState);
        });

        // Wire up Return Selected button
        const returnSelectedBtn = document.getElementById("returnSelectedBtn");
        if (returnSelectedBtn) {
          returnSelectedBtn.addEventListener("click", async () => {
            const selectedCheckboxes = Array.from(
              document.querySelectorAll(".equipment-checkbox:checked")
            );

            if (selectedCheckboxes.length === 0) {
              alert("Please select at least one item to return.");
              return;
            }

            returnSelectedBtn.disabled = true;

            const returnData = selectedCheckboxes.map((cb) => {
              const logID = parseInt(cb.dataset.logid);
              const damagedCheckbox = document.querySelector(
                `.damaged-checkbox[data-logid="${logID}"]`
              );
              const isDamaged = damagedCheckbox && damagedCheckbox.checked;

              return {
                logID: logID,
                equipment: cb.dataset.equipment,
                baseEquipment: cb.dataset.baseEquipment,
                damaged: isDamaged,
              };
            });

            try {
              const res = await fetch("/returnMany", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ returns: returnData }),
              });

              const data = await res.json();
              console.log("returnMany response:", data);

              if (data.success) {
                // Prepare success data and redirect
                const successData = {
                  issuedEquipment: returnData.map((r) => ({
                    equipment: r.equipment,
                    outNum: 1,
                  })),
                  name: "<%= student.name %>",
                  mode: "returned",
                };

                console.log("Storing success data:", successData);

                // Store in session via fetch, then redirect
                const storeRes = await fetch("/store-success-data", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(successData),
                });

                console.log(
                  "store-success-data response status:",
                  storeRes.status
                );
                const storeData = await storeRes.json();
                console.log("store-success-data response:", storeData);

                if (storeRes.ok && storeData.success) {
                  console.log("Redirecting to /show-success");
                  window.location.href = "/show-success";
                } else {
                  throw new Error(
                    "Failed to prepare success page: " +
                      (storeData.error || storeRes.statusText)
                  );
                }
              } else {
                alert("Error: " + data.error);
                returnSelectedBtn.disabled = false;
              }
            } catch (err) {
              console.error("Error:", err);
              alert("Network error: " + err.message);
              returnSelectedBtn.disabled = false;
            }
          });
        }
      });
    </script>
  </body>
</html>
