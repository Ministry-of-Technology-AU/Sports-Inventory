<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Landing Page</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style/landing.css" />
    <link rel="stylesheet" href="/style/return-page.css" />
    <link rel="stylesheet" href="/style/global.css" />

    <style>
      body {
        background-color: var(--off-white);
      }

      .button-group {
        display: flex;
        gap: 15px;
        justify-content: center;
        align-items: center;
      }

      #returnAllBtn {
        background: var(--primary-color);
        color: var(--text-color-secondary);
        border: none;
        padding: 16px 36px;
        font-size: 18px;
        font-weight: 600;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      #returnAllBtn:hover {
        background: var(--primary-color);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(13, 56, 98, 0.3);
      }
    </style>
  </head>

  <body>
    <%- include("nav",{ activePage: "landing" , config: "admin" , userName: user
    }) %>

    <div class="box">
      <div class="up">
        <h1 class="details">
          <p><%= student.name %></p>
          <p><%= student.AshokaId %></p>
        </h1>
        <h1>Pending Equipment Borrowed</h1>
        <h1 class="fake">H</h1>
      </div>

      <% if (equipment.length===0) { %>
      <p class="noPendingEquipment">No pending equipment</p>
      <% } else { %>

      <table border="1" cellpadding="5">
        <thead>
          <tr>
            <th>Equipment</th>

            <th>Checkout Time</th>
            <th>Damaged</th>
            <!-- SELECT ALL CHECKBOX ADDED HERE -->
            <th class="return-column checkbox-col">
              <div class="head-return">
                <span>Return All</span>
                <label class="checkbox">
                  <input id="selectAll" type="checkbox" />
                  <span class="checkmark"></span>
                </label>
              </div>
            </th>
          </tr>
        </thead>

        <tbody>
          <% equipment.forEach(function(item) { %>
          <tr>
            <td><%= item.equipment %></td>
            <td><%= item.outTime %></td>

            <!-- Damaged Checkbox -->
            <td class="return-column checkbox-col">
              <label class="checkbox">
                <input
                  class="damaged-checkbox"
                  type="checkbox"
                  data-eq="<%= item.equipment %>"
                  value="<%= item.logID %>"
                />
                <span class="checkmark"></span>
              </label>
            </td>

            <!-- Return Checkbox -->
            <td class="return-column checkbox-col">
              <label class="checkbox">
                <input
                  class="equipment-checkbox"
                  type="checkbox"
                  data-eq="<%= item.equipment %>"
                  value="<%= item.logID %>"
                />
                <span class="checkmark"></span>
              </label>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>

      <br />
      <% } %>

      <div class="bottom">
        <% if (equipment.length !=0) { %>
        <div class="button-group">
          <button id="returnAllBtn">Return All</button>
          <button id="returnSelectedBtn">Return Selected</button>
        </div>
        <% }%>
      </div>
    </div>

    <script>
      // POST Return Form Builder
      function submitReturnForm(selectedLogIDs) {
        const form = document.createElement("form");
        form.method = "POST";
        form.action = "/returnMany";

        // RETURNED logIDs
        selectedLogIDs.forEach((id) => {
          const input = document.createElement("input");
          input.type = "hidden";
          input.name = "logsReturned[]";
          input.value = id;
          form.appendChild(input);
        });

        // DAMAGED logIDs
        const damagedIDs = Array.from(
          document.querySelectorAll(".damaged-checkbox:checked")
        ).map((cb) => cb.value);

        damagedIDs.forEach((id) => {
          const input = document.createElement("input");
          input.type = "hidden";
          input.name = "logsDamaged[]";
          input.value = id;
          form.appendChild(input);
        });

        document.body.appendChild(form);
        form.submit();
      }

      // Return Selected
      document
        .getElementById("returnSelectedBtn")
        ?.addEventListener("click", () => {
          const selected = Array.from(
            document.querySelectorAll(".equipment-checkbox:checked")
          )
            .map((cb) => cb.value)
            .filter((v) => v.trim() !== "");

          if (selected.length === 0) {
            alert("Please select at least one item to return.");
            return;
          }

          submitReturnForm(selected);
        });

      // Return All
      document.getElementById("returnAllBtn")?.addEventListener("click", () => {
        if (!confirm("Are you sure you want to return all equipment?")) return;

        const all = Array.from(document.querySelectorAll(".equipment-checkbox"))
          .map((cb) => cb.value)
          .filter((v) => v.trim() !== "");

        submitReturnForm(all);
      });

      // -------------------------
      // SELECT ALL CHECKBOX LOGIC
      // -------------------------
      const selectAllBox = document.getElementById("selectAll");
      const rowCheckboxes = document.querySelectorAll(".equipment-checkbox");

      if (selectAllBox) {
        // When "Select All" changes -> toggle all row checkboxes
        selectAllBox.addEventListener("change", () => {
          const checked = selectAllBox.checked;
          rowCheckboxes.forEach((cb) => (cb.checked = checked));
        });

        // When any row checkbox changes -> sync Select All box
        rowCheckboxes.forEach((cb) => {
          cb.addEventListener("change", () => {
            const allChecked = Array.from(rowCheckboxes).every(
              (cb2) => cb2.checked
            );
            selectAllBox.checked = allChecked;
          });
        });
    </script>
  </body>
</html>
