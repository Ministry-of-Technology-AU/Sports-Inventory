<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Landing Page</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/style/landing.css" />
  <link rel="stylesheet" href="/style/return-page.css" />
  <link rel="stylesheet" href="/style/global.css" />
  <style>
    body {
      background-color: var(--off-white);
    }

    .button-group {
      display: flex;
      gap: 15px;
      justify-content: center;
      align-items: center;
    }

    #returnAllBtn {
      background: var(--primary-color);
      color: var(--text-color-secondary);
      border: none;
      padding: 16px 36px;
      font-size: 18px;
      font-weight: 600;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    #returnAllBtn:hover {
      background: var(--primary-color);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(13, 56, 98, 0.3);
    }
  </style>
</head>

<body>
  <%- include("nav",{ activePage: "landing" , config: "admin" , userName: user }) %>
    <div class="box">
      <div class="up">
        <h1 class="details">
          <p>
            <%= student.name %>
          </p>
          <p>
            <%= student.AshokaId %>
          </p>
        </h1>
        <h1>Pending Equipment Borrowed</h1>
        <h1 class="fake">H</h1>
      </div>

      <% if (equipment.length===0) { %>
        <p class="noPendingEquipment">No pending equipment</p>
        <% } else { %>
          <table border="1" cellpadding="5">
            <thead>
              <tr>
                <th>Equipment</th>
                <th>Quantity Borrowed</th>
                <th>Checkout Time</th>
                <th>Return</th>
              </tr>
            </thead>
            <tbody>
              <% equipment.forEach(function(item) { %>
                <tr>
                  <td>
                    <%= item.equipment %>
                  </td>
                  <td>
                    <%= item.outNum %>
                  </td>
                  <td>
                    <%= item.outTime %>
                  </td>
                  <td>
                    <label class="checkbox">
                      <input class="equipment-checkbox" type="checkbox" value="<%= item.equipment %>"
                        data-quantity="<%= item.outNum %>" />
                      <span class="checkmark"></span>
                    </label>
                  </td>
                </tr>
                <% }); %>
            </tbody>
          </table>

          <br />
          <% } %>

            <div class="bottom">
              <% if (equipment.length !=0) { %>
                <div class="button-group">
                  <button id="returnAllBtn">Return All</button>
                  <button id="returnSelectedBtn">Return Selected</button>
                </div>
                <% }%>
            </div>
    </div>

    <script>
      // Return Selected functionality
      document
        .getElementById("returnSelectedBtn")
        ?.addEventListener("click", async () => {
          const selected = Array.from(
            document.querySelectorAll(".equipment-checkbox:checked")
          ).map((cb) => ({
            equipment: cb.value,
            outNum: cb.dataset.quantity
          }));

          if (selected.length === 0) {
            alert("Please select at least one item to return.");
            return;
          }

          try {
            const res = await fetch("/returnMany", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ equipments: selected.map(s => s.equipment) }),
            });

            const data = await res.json();

            if (data.success) {
              // Call success endpoint with returned equipment data
              const successRes = await fetch("/success", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  issuedEquipment: selected,
                  name: "<%= student.name %>",
                  mode: "returned"
                }),
              });

              const successHtml = await successRes.text();
              document.open();
              document.write(successHtml);
              document.close();
            } else {
              alert("Error: " + data.error);
            }
          } catch (err) {
            alert("Network error: " + err.message);
          }
        });

      // Return All functionality
      document
        .getElementById("returnAllBtn")
        ?.addEventListener("click", async () => {
          if (!confirm("Are you sure you want to return all equipment?")) {
            return;
          }

          // Get all equipment names and quantities from the table
          const allEquipment = Array.from(
            document.querySelectorAll(".equipment-checkbox")
          ).map((cb) => ({
            equipment: cb.value,
            outNum: cb.dataset.quantity
          }));

          try {
            const res = await fetch("/returnMany", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ equipments: allEquipment.map(e => e.equipment) }),
            });

            const data = await res.json();

            if (data.success) {
              // Call success endpoint with returned equipment data
              const successRes = await fetch("/success", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  issuedEquipment: allEquipment,
                  name: "<%= student.name %>",
                  mode: "returned"
                }),
              });

              const successHtml = await successRes.text();
              document.open();
              document.write(successHtml);
              document.close();
            } else {
              alert("Error: " + data.error);
            }
          } catch (err) {
            alert("Network error: " + err.message);
          }
        });
    </script>
</body>

</html>