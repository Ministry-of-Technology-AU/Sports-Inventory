<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Issue Equipment</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style/issue.css" />
  </head>

  <body>
    <%- include("nav",{ activePage: "issue" }) %>

    <div class="box">
      <div class="up">
        <h1 class="details">
          <p><%= student.name %></p>
          <p><%= student.AshokaId %></p>
        </h1>
        <h1>Issue Equipment</h1>
        <h1 class="fake">H</h1>
      </div>

      <form id="issueForm" action="/issue" method="POST" novalidate>
        <!-- prettier-ignore -->
        <% 
          // Define all equipment and corresponding image filenames
          const equipmentList1 = [
            { name: "Badminton Racquet", img: "badminton racquet.jpeg" },
            { name: "Squash Racquet", img: "badminton racquet.jpeg" },
            { name: "Tennis Racquet", img: "TT Racquet.jpg" },
            { name: "Table Tennis Racquet", img: "TT Racquet.jpg" },
            { name: "Cycle", img: "squash racquet.jpg" },
            { name: "Pickleball Racquet", img: "squash racquet.jpg" },
            { name: "Pool Stick", img: "tennis racquet.webp" },
            { name: "Football", img: "tennis racquet.webp" },
            { name: "Basketball", img: "pickleball.jpg" },
            { name: "Volleyball", img: "pickleball.jpg" },
            { name: "Yoga Mat", img: "pool stick.webp" },
            { name: "Cricket Bat", img: "cycle.jpg" },
            { name: "", img: "football.jpeg" },
            { name: "Chess", img: "pool stick.webp" },
            { name: "Fooseball", img: "cycle.jpg" },
            { name: "Frisbee", img: "football.jpeg" }
          ];
        %>
        <div class="header">
          <div class="card-child">Icon</div>
          <div class="card-child">Equipment</div>
          <div class="card-child">Availability</div>
          <div class="card-child">Issue Amount</div>
        </div>
        <% equipmentList1.forEach(item => { %>
        <div class="card">
          <div class="image-holder card-child">
            <img src="/images/<%= item.img %>" alt="<%= item.name %>" />
          </div>
          <label class="card-child"><%= item.name %></label>
          <p class="availability card-child">
            <%= availableItems[item.name] || 0 %>
          </p>
          <div class="something card-child">
            <button type="button" class="decrement">-</button>
            <input
              type="number"
              name="quantity[<%= item.name %>]"
              value="0"
              min="0"
              step="1"
            />
            <button type="button" class="increment">+</button>
          </div>
        </div>
        <% }) %>
      </form>
      <div class="bottom">
        <p>Sports Inventory Management</p>
        <button id="submitButton" type="submit" form="issueForm">Submit</button>
      </div>
    </div>

    <script>
      const submitButton = document.getElementById("submitButton");

      // Disable submit by default
      submitButton.disabled = true;

      function checkIfAnyPositive() {
        const inputs = document.querySelectorAll('input[type="number"]');
        const anyPositive = Array.from(inputs).some(
          (input) => parseInt(input.value) > 0
        );
        submitButton.disabled = !anyPositive;
      }

      document.querySelectorAll(".card").forEach((card) => {
        const availabilityText =
          card.querySelector(".availability").textContent;
        const availableMatch = availabilityText.match(/(\d+)/);
        const available = availableMatch ? parseInt(availableMatch[1]) : 0;
        const input = card.querySelector("input[type=number]");
        const incBtn = card.querySelector(".increment");
        const decBtn = card.querySelector(".decrement");

        // Disable if none available
        if (available === 0) {
          incBtn.disabled = true;
          input.disabled = true;
          card.style.opacity = "0.6";
        }

        // Increment button
        incBtn.addEventListener("click", () => {
          let val = parseInt(input.value) || 0;
          if (val < available) {
            input.value = val + 1;
            checkIfAnyPositive();
          }
        });

        // Decrement button
        decBtn.addEventListener("click", () => {
          let val = parseInt(input.value) || 0;
          input.value = Math.max(0, val - 1);
          checkIfAnyPositive();
        });

        // When user types manually
        input.addEventListener("input", () => {
          let val = parseInt(input.value) || 0;
          if (val > available) input.value = available;
          if (val < 0) input.value = 0;
          checkIfAnyPositive();
        });
      });
    </script>
  </body>
</html>
