<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style/global.css" />
    <link rel="stylesheet" href="/style/index.css" />
    <link rel="stylesheet" href="/style/landing.css" />
    <script
      src="https://kit.fontawesome.com/2cacd0cbd0.js"
      crossorigin="anonymous"
    ></script>
  </head>

  <body>
    <%- include("nav",{ activePage: "landing" , config:"admin", userName: user
    }) %>
    <div class="box">
      <i
        class="fa-solid fa-circle-check"
        style="color: #63e6be; font-size: 100px; margin-bottom: 20px"
      ></i>
      <h1>
        Equipment returned for <br />
        <span style="color: var(--primary-color)"> <%= studentName %> </span>
      </h1>
      <% if (equipment.length===0) { %>
      <p class="noPendingEquipment">No pending equipment</p>
      <% } else { %>
      <table border="1" cellpadding="5">
        <thead>
          <tr>
            <th>Equipment</th>
            <th>Quantity Returned</th>
          </tr>
        </thead>
        <tbody>
          <% equipment.forEach(function(item) { %>
          <tr>
            <td><%= item.equipment %></td>
            <td><%= item.inNum %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>

      <br />
      <% } %>
    </div>
  </body>
</html>
