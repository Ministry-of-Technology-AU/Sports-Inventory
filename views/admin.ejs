<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style/global.css" />
    <link rel="stylesheet" href="/style/index.css" />
    <link rel="stylesheet" href="/style/admin.css" />
    <link rel="stylesheet" href="/style/landing.css" />
    <script
      src="https://kit.fontawesome.com/2cacd0cbd0.js"
      crossorigin="anonymous"
    ></script>
  </head>

<body>
    <%- include("nav",{ activePage: "admin" , config:"admin", userName: user })
    %>
    <div class="body-wrapper">
      <div class="actions-menu">
        <h1>Actions</h1>
        <li class="actions-buttons-list">
          <span
            ><i class="fa-solid fa-basketball"></i>
            <button type="button" class="update-inventory-btn">
              Update Inventory
            </button></span
          >
          <span
            ><i class="fa-solid fa-person-circle-check"></i>
            <button type="button" class="sports-requests-btn">
              Create Sports Team Entry
            </button></span
          >
          <span
            ><i class="fa-solid fa-triangle-exclamation"></i
            ><button class="view-offences-btn" type="button">
              View Offences
            </button></span
          >
          <span
            ><i class="fa-solid fa-square-poll-vertical"></i
            ><a href="/statistics">View Statistics</a></span
          >
        </li>
      </div>
      <div class="content-box">
        <div class="update-inventory-section">
          <table border="1" cellpadding="5">
            <thead>
              <tr>
                <th>Equipment</th>
                <th>Total Quantity</th>
                <th>Reserved for Teams</th>
                <th>Damaged</th>
                <th>In-use</th>
                <th>Delete</th>
              </tr>
            </thead>
            <tbody id="inventory-table-body">
              <% equipment.forEach(function(item) { %>
              <tr>
                <td contenteditable="true"><%= item.equipment %></td>
                <td><%= item.totalQuantity %></td>
                <td contenteditable="true"><%= item.reservedQuantity %></td>
                <td contenteditable="true"><%= item.damagedQuantity %></td>
                <td contenteditable="true"><%= item.inUseQuantity %></td>
                <td
                  class="delete-btn"
                  style="cursor: pointer; text-align: center"
                >
                  <i class="fa-solid fa-trash"></i>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <button class="add-equipment-btn">Add Equipment</button>
          <button class="save-inventory-btn">Save Changes</button>
        </div>
        <div class="sports-requests" style="display: none">
          <h2>Request Sports Equipment</h2>

          <form id="sports-request-form">
            <label>Student Name:</label>
            <input name="studentName" type="text" id="studentName" required />

            <label>Student Email:</label>
            <input name="email" type="email" id="studentEmail" required />

            <label for="equipment">Equipment:</label>
            <select name="equipment" id="equipment" required>
              <option value="" disabled selected>Loading...</option>
            </select>

            <label>Quantity:</label>
            <input
              name="quantity"
              type="number"
              id="quantity"
              min="1"
              required
            />

            <label>Valid Till:</label>
            <input name="endDate" type="date" id="endDate" required />

            <button class="sports-request-submit" type="submit">
              Submit Request
            </button>
          </form>
        </div>
        <div class="view-offences-section" style="display: none">
          <table border="1" cellpadding="5">
            <thead>
              <tr>
                <th>StudentID</th>
                <th>Student Name</th>
                <th>Student Email</th>
                <th>Borrowed Outstanding</th>
                <th>Offences</th>
              </tr>
            </thead>
            <tbody id="offence-table-body">
              <% offenceList.forEach(function(student) { %>
              <tr>
                <td><%= student.studentID %></td>
                <td><%= student.studentName %></td>
                <td><%= student.studentEmail %></td>
                <td><%= student.borrowedOutstanding %></td>
                <td><%= student.offences %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  <!--section toggle script-->
  <script>
    document
      .querySelector(".update-inventory-btn")
      .addEventListener("click", function () {
        const section_1 = document.querySelector(".sports-requests");
        section_1.style.display = "none";
        const section_2 = document.querySelector(".view-offences-section");
        section_2.style.display = "none";
        const section = document.querySelector(".update-inventory-section");
        section.style.display = "block";
      });

    document
      .querySelector(".sports-requests-btn")
      .addEventListener("click", function () {
        const section_1 = document.querySelector(".update-inventory-section");
        section_1.style.display = "none";
        const section_2 = document.querySelector(".view-offences-section");
        section_2.style.display = "none";
        const section = document.querySelector(".sports-requests");
        section.style.display = "block";
      });
    document
      .querySelector(".view-offences-btn")
      .addEventListener("click", function () {
        const section_1 = document.querySelector(".update-inventory-section");
        section_1.style.display = "none";
        const section = document.querySelector(".sports-requests");
        section.style.display = "none";
        const section_2 = document.querySelector(".view-offences-section");
        section_2.style.display = "block";
      });
  </script>

  <!--update inventory script-->
  <script>
    document
      .querySelector(".add-equipment-btn")
      .addEventListener("click", function () {
        const tableBody = document.getElementById("inventory-table-body");
        const newRow = document.createElement("tr");
        newRow.innerHTML = `
        <td contenteditable="true"></td>
        <td contenteditable="true">0</td>
        <td contenteditable="true">0</td>
        <td contenteditable="true">0</td>
        <td contenteditable="true">0</td>
        <td class="delete-btn" style="cursor:pointer; text-align:center;">
            <i class="fa-solid fa-trash"></i>
        </td>
    `;
        tableBody.appendChild(newRow);
      });
    document.addEventListener("click", function (e) {
      if (e.target.closest(".delete-btn")) {
        const row = e.target.closest("tr");
        const equipmentName = row.querySelector("td").innerText.trim();

        // If empty new row → just remove
        if (!equipmentName) {
          row.remove();
          return;
        }

        // Otherwise confirm delete
        if (!confirm(`Delete "${equipmentName}" from inventory?`)) return;

        fetch("/delete_equipment", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ equipment: equipmentName }),
        })
          .then((res) => res.json())
          .then((data) => {
            alert(data.message);
            row.remove();
          })
          .catch(() => alert("Delete failed"));
      }
    });

    document
      .querySelector(".save-inventory-btn")
      .addEventListener("click", function () {
        const rows = document.querySelectorAll("#inventory-table-body tr");
        const data = [];

        rows.forEach((row) => {
          const cells = row.querySelectorAll("td");
          data.push({
            equipment: cells[0].innerText.trim(),
            totalQuantity: parseInt(cells[1].innerText.trim(), 10),
            reservedQuantity: parseInt(cells[2].innerText.trim(), 10),
            damagedQuantity: parseInt(cells[3].innerText.trim(), 10),
            inUseQuantity: parseInt(cells[4].innerText.trim(), 10),
          });

          // Remove highlight after saving
          cells.forEach((cell) => (cell.style.backgroundColor = ""));
        });
        fetch("/update_inventory", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ inventory: data }),
        })
          .then((res) => res.json())
          .then((msg) => {
            alert(msg.message);
            location.reload();
          })
          .catch(() => alert("Update failed"));
      });

    document.addEventListener("input", function (e) {
      if (e.target.tagName === "TD" && e.target.isContentEditable) {
        e.target.style.backgroundColor = "#fff3b0"; // light yellow
      }
    });
  </script>

  <!--sports requests script-->
  <script>
    document
      .getElementById("sports-request-form")
      .addEventListener("submit", async function (e) {
        e.preventDefault();

        const requestData = {
          studentName: document.getElementById("studentName").value.trim(),
          studentEmail: document.getElementById("studentEmail").value.trim(),
          equipment: document.getElementById("equipment").value.trim(),
          quantity: parseInt(document.getElementById("quantity").value, 10),
          endDate: document.getElementById("endDate").value,
        };

        const today = new Date().toISOString().split("T")[0]; // midnight date

        requestData.startDate = today; // auto-assign today

        fetch("/sports_request", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(requestData),
        })
          .then((res) => res.json())
          .then((data) => alert(data.message))
          .catch(() => alert("Something went wrong!"));
      });
  </script>

  <script>
    async function loadEquipment() {
      try {
        const response = await fetch("/getequipment");
        const data = await response.json();

        const select = document.getElementById("equipment");
        select.innerHTML =
          '<option value="" disabled selected>Select Equipment</option>';

        // Handle both array and object response formats
        const equipmentList = Array.isArray(data) ? data : (data.equipment || []);

        equipmentList.forEach((item) => {
          const equipmentName = typeof item === "string" ? item : item.equipment;
          const reservedQty = typeof item === "string" ? 0 : (item.reservedQuantity || 0);

          const option = document.createElement("option");
          option.value = equipmentName;
          option.textContent = equipmentName;
          option.dataset.max = reservedQty;
          select.appendChild(option);
        });
      } catch (err) {
        console.error("Error loading equipment:", err);
        const select = document.getElementById("equipment");
        select.innerHTML =
          '<option value="" disabled selected>Error loading equipment</option>';
      }
    }

    document.addEventListener("DOMContentLoaded", loadEquipment);
  </script>

  <!-- setting the cap for not exceeding reserved quantity in sports team requests -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const equipmentSelect = document.getElementById("equipment");
      const qtyInput = document.getElementById("quantity");

      equipmentSelect.addEventListener("change", () => {
        const selected = equipmentSelect.options[equipmentSelect.selectedIndex];
        const max = parseInt(selected.dataset.max || "0", 10);

        qtyInput.max = max;
        qtyInput.value = "";
        qtyInput.placeholder = `Max: ${max}`;
      });

      qtyInput.addEventListener("input", () => {
        const max = parseInt(qtyInput.max, 10);
        if (!isNaN(max) && qtyInput.value > max) {
          alert(`You cannot issue more than ${max}.`);
          qtyInput.value = max;
        }
      });
    });
  </script>
</html>
